# ---------------------------------------------------------------------------
# SEGREDOS — nunca entram no repositório.
#
# A chave de assinatura é o ativo mais crítico do projeto: quem a tiver publica
# atualizações em teu nome na Play Store, e a Google não a substitui sem um
# processo de recuperação. Fica só no disco e na cópia de segurança pessoal.
# ---------------------------------------------------------------------------
*.jks
*.keystore
keystore.properties
android/keystore.properties
android/local.properties
google-services.json
.env
.env.*
!.env.example

# Builds assinados (35 MB cada) — arquivados à parte, fora do git.
_backup/
*.aab
*.apk

# ---------------------------------------------------------------------------
# Dependências e saídas de build
# ---------------------------------------------------------------------------
node_modules/
.expo/
dist/
web-build/
android/build/
android/app/build/
android/.gradle/
android/.cxx/
ios/build/
ios/Pods/
*.hprof

# ---------------------------------------------------------------------------
# Dados do mundo — gerados a partir do Excel por scripts/import-world-ratings.
# São ~1,8 MB de ficheiros derivados: reconstroem-se, não se versionam.
# `npm run smoke:data` valida-os depois de gerados.
# ---------------------------------------------------------------------------
src/core/data/world/

# Folhas de cálculo de origem e imagens de trabalho (pesadas, não são código).
docs/*.xlsx
docs/*.png

# ---------------------------------------------------------------------------
# Ferramentas e sistema
# ---------------------------------------------------------------------------
expo-env.d.ts
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/*
!.vscode/settings.json
.diag/

# E2E (Playwright) — artefactos gerados
web-build/
test-results/
playwright-report/
test-results/
e2e/__screens__/
